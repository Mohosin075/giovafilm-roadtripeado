  {
    "_id": "6a024a96d5f1a69dce5ad750",
    "name": "Iglesia vieja",
    "map": "69e912c3668604cc97522d2a",
    "category": "6a024a70d5f1a69dce5ad4bd",
    "country": "Puerto Rico",
    "description": "Esta iglesia, construida en 1931, es una estructura abandonada que ha sido parcialmente cubierta por la vegetacion del bosque seco subtropical. Su arquitectura y estado actual le confieren un aspecto mistico y pintoresco, atrayendo a fotografos y exploradores urbanos. El sitio es parte de un area que ha sido revitalizada por voluntarios y entusiastas del ciclismo de montana.",
    "media": [
      "/uploads/images/1786940181287-078kloxwu95a.jpg",
      "/uploads/images/1786940181600-zc8ok3xwr3f.jpg",
      "/uploads/images/1786940182079-ktopbnji9yo.jpg"
    ],
    "address": "Puerto Rico",
    "location": {
      "type": "Point",
      "coordinates": [
        -67.1817137,
        18.1656578
      ]
    },
    "status": "Published",
    "difficulty": "Easy",
    "createdAt": "2026-05-11T21:31:02.760Z",
    "updatedAt": "2026-08-09T09:25:29.704Z",
    "__v": 0,
    "type": "Regular",
    "services": [],
    "rating": 0,
    "totalReview": 0,
    "openCount": 0,
    "accessibility": {
      "features": [],
      "notes": ""
    },
    "access": "The church is located within the Monte Pirata Bike Park, on the grounds of the former Juvenile Correctional Prison. Access is by vehicle to a nearby point, followed by a moderate walk along natural trails. It is recommended to wear appropriate footwear and water.",
    "recommendations": {
      "tips": "Ideal for lovers of history, photography and exploration. It is recommended to visit during the day and with caution, as the terrain can be uneven and slippery, especially after rain. Bringing a camera to capture the uniqueness of the place is highly recommended."
    }
  },
